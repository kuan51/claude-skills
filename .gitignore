# Python bytecode, from the docs-warden scripts and their test suite.
__pycache__/
*.pyc

# Generated by docs-warden's audit
docs-scorecard.json

# Vale assets generated from docs/GLOSSARY.md by glossary_to_vale.py.
# Only these two paths are generated. The hand-copied Clarity rule files
# beside them must stay tracked, or CI checks out a tree where vale cannot
# resolve BasedOnStyles.
styles/config/vocabularies/Project/
styles/Clarity/GlossaryTerms.yml

# Third-party Vale packages fetched by `vale sync` per .vale.ini's Packages =
# line. Regenerated on demand -- do not vendor them.
styles/Microsoft/
styles/write-good/
styles/proselint/
styles/ai-tells/
styles/config/templates/

# Secrets - never commit these
*.env
.env.*

# fabflows benchmark raw outputs (transcripts, fixtures, snapshots, logs) stay out of git. The small
# per-iteration evidence behind evals/RESULTS.md is tracked so its tables can be checked without
# re-running: git cannot re-include a file inside an ignored directory, hence the contents-only rules.
plugins/fabflows/evals/runs/*
!plugins/fabflows/evals/runs/iteration-*/
plugins/fabflows/evals/runs/iteration-*/*
!plugins/fabflows/evals/runs/iteration-*/cells.json
!plugins/fabflows/evals/runs/iteration-*/benchmark.json
!plugins/fabflows/evals/runs/iteration-*/benchmark.md
