# Python bytecode, from the docs-warden scripts and their test suite.
__pycache__/
*.pyc

# Generated by docs-warden's audit
docs-scorecard.json

# Vale assets generated from docs/GLOSSARY.md by glossary_to_vale.py.
# Only these two paths are generated. The hand-copied Clarity rule files
# beside them must stay tracked, or CI checks out a tree where vale cannot
# resolve BasedOnStyles.
styles/config/vocabularies/Project/
styles/Clarity/GlossaryTerms.yml

# Third-party Vale packages fetched by `vale sync` per .vale.ini's Packages =
# line. Regenerated on demand -- do not vendor them.
styles/Microsoft/
styles/write-good/

# Secrets - never commit these
*.env
.env.*
