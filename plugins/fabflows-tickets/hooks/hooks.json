{
  "description": "fabflows-tickets ticket.js -- links a branch to its tracker ticket, requires Refs and Spec commit trailers and the key in the PR title, reminds Claude to update the ticket after a push, PR creation and merge, and at startup names the other linked tickets whose recorded PR may have merged or closed.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/ticket.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|PowerShell|mcp__.*create_pull_request)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/ticket.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|PowerShell|mcp__.*(create|merge)_pull_request)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/ticket.js\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
