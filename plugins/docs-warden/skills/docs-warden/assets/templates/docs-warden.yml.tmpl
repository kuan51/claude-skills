# Drives every docs-warden script. Confirm every value before writing.
archetype: {{ARCHETYPE}}        # it-tooling | service | library | firmware
forge: {{FORGE}}               # github | gitlab | none; omitted means github
owner: {{OWNER}}
review_cadence_days: 180

# Compliance overlays, each adding required artifacts on top of the archetype.
# Omit the key, or leave it empty, when none apply. A standard with a level axis
# takes its level; one without takes true. See references/standards.md.
standards: {{STANDARDS}}
#  iec-62304: C      # safety class A | B | C -- assigned outside the repo. Ask.

# Documents this repository requires beyond the standard set.
extra_files: []
#  - docs/oncall.md

# Checks this repository has excused, each with the reason why. A waiver shows
# in the scorecard as `waived`, never as a pass, and one with no reason is
# rejected. See references/audit-schema.md.
waivers: {}
#  required-files: "the runbook lives in the ops wiki, see DEC-0009"

# CI regenerates each path with its command and fails on any diff.
generated_docs: []
#  - path: docs/reference/cli.md
#    command: ["pwsh", "./build/Export-Help.ps1"]
